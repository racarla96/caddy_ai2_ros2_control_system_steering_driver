<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caddy_ai2_ros2_control_system_steering_driver</name>
  <version>0.0.1</version>
  <description>ros2_control Controller plugin that drives the Caddy AI2 steering system over CAN/CANopen</description>
  <maintainer email="racarla1@inf.upv.es">Rafael Carbonell Lázaro</maintainer>
  <license>CC-BY-4.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ros2_control_cmake</buildtool_depend>

  <build_depend>backward_ros</build_depend>
  <build_depend>generate_parameter_library</build_depend>

  <depend>controller_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>std_msgs</depend>
  <depend>caddy_ai2_ros2_common</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
